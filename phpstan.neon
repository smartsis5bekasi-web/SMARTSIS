includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Livewire v4 single-file components live in Blade files, which PHPStan
    # cannot analyse, so traits consumed only by them look unused.
    ignoreErrors:
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/*

    reportUnmatchedIgnoredErrors: true
